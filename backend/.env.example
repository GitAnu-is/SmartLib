# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Note for teams sharing Spring Boot config:
# - Spring keys like spring.data.mongodb.uri / spring.mongodb.uri are NOT used here.
# - For this Node/Express backend, copy only the URI value into MONGODB_URI.
MONGODB_URI=mongodb://127.0.0.1:27017/smartlib
# Optional Atlas fallback if mongodb+srv DNS fails on your machine:
# MONGODB_URI=mongodb://<USERNAME>:<PASSWORD>@host1:27017,host2:27017,host3:27017/<DB_NAME>?ssl=true&authSource=admin&replicaSet=<REPLICA_SET>&retryWrites=true&w=majority
JWT_SECRET=change_me

# SMTP (for overdue reminder emails)
# For Gmail, use an App Password and set SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="SmartLib <no-reply@smartlib.local>"
